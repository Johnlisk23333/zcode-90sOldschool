# .cmd 必须保持 GBK + CRLF：按二进制原样提交，禁止 Git 换行/编码转换
*.cmd -text -diff
*.bat -text -diff

# 源码统一 LF（Windows 侧脚本由解释器按行处理，不受影响）
*.js    text eol=lf
*.py    text eol=lf
*.pyw   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.cjs   text eol=lf

# 二进制资源
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.zip binary
